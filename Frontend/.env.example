# Base URL of the Race Simulator API.
#
# The backend serves /api/v1 and defaults to port 8080, but the documented
# local setup runs it on 8081 because Jenkins occupies 8080 on the development
# machine (Backend/BACKEND_DATABASE_INTEGRATION_GUIDE.md, section 9):
#
#   cd Backend && SERVER_PORT=8081 mvn spring-boot:run
#
# Copy this file to Frontend/.env.local and adjust if your backend differs.
# .env.local is git-ignored; do not commit a developer-specific .env file.
#
# This value is public: it is compiled into the browser bundle. Never put a
# credential, token or password in a VITE_ variable.
VITE_API_BASE_URL=http://localhost:8081/api/v1
